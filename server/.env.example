# Gather uses one .env at the repository root (dotenv runs from that directory).
# Copy this file to the repository-root .env, then replace secret placeholders.
# All credentials/URLs below are synthetic local examples, never production secrets.
# Cloud Run receives the same runtime settings through its service/job configuration.

# Required: persistent application PostgreSQL database. Use Cloud SQL in GCP.
DATABASE_URL=postgresql://event_app:local-demo-password@localhost:5432/event_system_dev
# Tests only: a SEPARATE disposable database ending in _test; tests delete its data.
# Do not configure this on the Cloud Run web service.
TEST_DATABASE_URL=postgresql://event_app:local-demo-password@localhost:5432/event_system_test
# Required: replace with at least 32 random characters; use Secret Manager in GCP.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Keep stable across instances/revisions to preserve signed sessions.
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters-long
# Optional: local default 3000. Cloud Run injects PORT; bind to 0.0.0.0.
PORT=3000
# Runtime mode: development locally; production enables Secure cookies behind HTTPS.
# The Docker runtime defaults to production; preserve that setting in Cloud Run.
NODE_ENV=development

# Local/test seed only: synthetic value, 12–256 characters. No built-in password.
# Set privately before db:seed; production UAT must use separate passphrases below.
# DEMO_PASSWORD=replace-with-your-own-demo-secret
# Production UAT seed/reset jobs only: JSON with distinct passphrases for all four
# demo identities. Store in Secret Manager; never set on the web service.
# DEMO_PASSWORDS_JSON=<Secret Manager value; see docs/labs/lab-05/deployment.md>
# Optional, default false: production UAT seed jobs must explicitly opt in.
# Leave false/unset on the web service; never seed automatically during startup.
# ALLOW_DEMO_SEED=false
# Cloud Run password reset job only: set to true for an explicit demo reset.
# Keep this flag unset on the web service.
# ALLOW_DEMO_PASSWORD_RESET=false
# Optional: max PostgreSQL connections per instance, default 10, allowed 1–100.
# Budget across all Cloud Run instances/revisions, jobs and maintenance connections.
# DB_POOL_MAX=10

# Local Docker Compose only: synthetic default; keep this URL-safe because Compose
# interpolates it into its local DATABASE_URL. Cloud Run does not use Compose.
# POSTGRES_PASSWORD=local-demo-password

# The Vite client reads no environment variables and calls /api on the same origin.
# Never place server/database/session secrets in VITE_* variables or client code.
# Optional operator-only migration profile (unset preserves the existing runner).
# Never set on the web runtime. Requires reviewed owner membership/ACLs.
# MIGRATION_OWNER_ROLE=gather
