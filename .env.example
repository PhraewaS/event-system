# Copy to .env. Use separate databases: tests deliberately clear their own data.
DATABASE_URL=postgresql://event_app:local-demo-password@localhost:5432/event_system_dev
TEST_DATABASE_URL=postgresql://event_app:local-demo-password@localhost:5432/event_system_test
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters-long
PORT=3000
NODE_ENV=development
# Demo data only; override before seeding. Never seed production.
DEMO_PASSWORD=Gather-demo-2026!
